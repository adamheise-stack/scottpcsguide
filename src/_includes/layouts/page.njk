{% extends "layouts/base.njk" %}
{% block schema %}
{%- if faq %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq | faqLd
} | json | safe }}</script>
{%- endif %}
{% endblock %}
{% block main %}
{%- set sec = sections[section] if section else null %}
{%- set heroIcon = icon or (section if sec else ("list" if page.url == "/guides/" else "compass")) %}
<div class="page-hero tone-{{ sec.tone if sec else 'sky' }}">
  <div class="wrap page-hero__inner">
    {% include "breadcrumbs.njk" %}
    {% if section %}{% categorySponsor section %}{% endif %}
    <div class="page-hero__head">
      <span class="page-hero__icon">{% icon heroIcon %}</span>
      <div class="page-hero__text">
        <h1>{{ title }}</h1>
        {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
        {% if updated %}<p class="meta">{% icon "clock" %} <strong>Last verified <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time></strong></p>{% endif %}
      </div>
    </div>
  </div>
</div>
<div class="wrap">
<div class="layout{% if hideSidebar %} layout--single{% endif %}">
  <div class="content prose">
    {%- set body = content | headingIds %}
    {%- set tocItems = body | toc %}
    {%- if section and tocItems.length > 3 %}
    <details class="toc toc--inline toc--page">
      <summary>{% icon "list" %} On this page</summary>
      <nav aria-label="On this page"><ol>{% for t in tocItems %}<li><a href="#{{ t.id }}">{{ t.text | safe }}</a></li>{% endfor %}</ol></nav>
    </details>
    {%- endif %}
    {{ body | safe }}
    {%- if section %}
    {%- set related = collections.guides | selectattr("data.section", "equalto", section) %}
    <h2>Guides in this section</h2>
    {%- if related.length %}
    <ul class="cards cards--guides">
      {%- for g in related %}{% include "guide-card.njk" %}{% endfor %}
    </ul>
    {%- else %}
    <p class="coming-soon">{% icon "clock" %} <span>A full guide for this section is coming soon. Until then, the official links above are the best place to start.</span></p>
    {%- endif %}
    {%- endif %}
  </div>
  {%- if not hideSidebar %}
  <div class="sidebar">
    {% if section %}{% featuredListings section %}{% endif %}
    {% include "related.njk" %}
  </div>
  {%- endif %}
</div>
{%- if section %}
<section class="explore" aria-labelledby="explore-title">
  <h2 id="explore-title" class="section-title">Explore other topics</h2>
  <ul class="topics topics--compact">
  {%- for key, s in sections %}{% if key != section %}{% include "topic-card.njk" %}{% endif %}{% endfor %}
  </ul>
</section>
{%- endif %}
</div>
{% endblock %}
