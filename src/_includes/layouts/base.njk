<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.name) if title and page.url != "/" else (site.name + " | " + site.tagline) %}
{%- set canonical = page.url | absUrl(site.url) %}
{%- set ogImg = site.ogImage | absUrl(site.url) %}
<title>{{ seoTitle or pageTitle }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/guide.njk' else 'website' }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta name="twitter:title" content="{{ title or site.name }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImg }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImg }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="{{ site.locale }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#17324d">
<script>(function(d){d.className="js rv";setTimeout(function(){if(!window.pcsReady)d.classList.remove("rv")},2500)})(document.documentElement)</script>
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/css/style.css">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.name,
  "url": site.url + "/",
  "description": site.tagline,
  "inLanguage": "en-US",
  "publisher": { "@type": "Organization", "@id": site.url + "/#organization", "name": site.name, "url": site.url + "/", "logo": site.ogImage | absUrl(site.url) }
} | json | safe }}</script>
{%- if page.url == "/" %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": site.url + "/#organization",
  "name": site.name,
  "url": site.url + "/",
  "logo": site.ogImage | absUrl(site.url),
  "description": "An independent, privately run guide for military families moving to Scott AFB, Illinois. Not affiliated with or endorsed by the U.S. Air Force, the Department of Defense, or Scott Air Force Base.",
  "areaServed": { "@type": "Place", "name": "Scott AFB area and the St. Louis Metro East, Illinois" },
  "publishingPrinciples": "/disclaimer/" | absUrl(site.url)
} | json | safe }}</script>
{%- endif %}
{%- if breadcrumbs %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs | breadcrumbLd(site.url)
} | json | safe }}</script>
{%- endif %}
{% block schema %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% include "sprite.njk" %}
<header class="site-header" id="top">
  <div class="wrap header-inner">
    <a class="brand" href="/">{% include "logo.njk" %}<span class="brand__text"><span class="brand__name">{{ site.name }}</span><span class="brand__sub">Scott AFB, IL · Independent guide</span></span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">{% icon "menu", "menu-btn__open" %}{% icon "close", "menu-btn__close" %}<span class="menu-btn__label">Menu</span></button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list">
      {%- for item in nav %}
        {%- set isCurrent = page.url.startsWith(item.url) or (section and sections[section] and sections[section].url == item.url) %}
        <li><a class="nav-link" href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{% icon item.icon, "nav-link__icon" %}<span class="nav-link__full">{{ item.title }}</span><span class="nav-link__short">{{ item.short }}</span></a></li>
      {%- endfor %}
        <li class="nav-cta"><a class="btn btn--primary" href="/guides/scott-afb-pcs-first-week-guide/">New to Scott? Start here {% icon "arrow" %}</a></li>
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{% block main %}{{ content | safe }}{% endblock %}
</main>
<footer class="site-footer">
  <svg class="footer-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 60V28c160-26 320-30 480-14s320 26 480 10 320-30 480-10v46Z"/></svg>
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="brand brand--footer" href="/">{% include "logo.njk" %}<span class="brand__text"><span class="brand__name">{{ site.name }}</span><span class="brand__sub">{{ site.tagline }}</span></span></a>
        <p class="disclaimer"><strong>Independent site.</strong> {{ site.name }} is not affiliated with or endorsed by the U.S. Air Force, the Department of Defense, or Scott Air Force Base. Information may change; always verify with official sources before making decisions. Sponsored content is always labeled. <a href="/disclaimer/">Full disclaimer</a>.</p>
      </div>
      <nav class="footer-map" aria-label="Site map">
        <div>
          <h2 class="footer-map__title">Topics</h2>
          <ul>{% for key, s in sections %}<li><a href="{{ s.url }}">{{ s.title }}</a></li>{% endfor %}</ul>
        </div>
        <div>
          <h2 class="footer-map__title">Guides</h2>
          <ul>{% for g in collections.guides %}<li><a href="{{ g.url }}">{{ g.data.navTitle or g.data.title | replace(": Newcomers Checklist and First-Week Guide (2026)", ": first-week checklist") | replace(": Full Table and What It Covers Locally", "") }}</a></li>{% endfor %}<li><a href="/guides/">All guides</a></li></ul>
        </div>
        <div>
          <h2 class="footer-map__title">This site</h2>
          <ul class="footer-links"><li><a href="/about/">About</a></li><li><a href="/about/#sponsorship">Sponsorship</a></li><li><a href="/visitor-center/">Visitor center links</a></li><li><a href="/disclaimer/">Disclaimer</a></li><li><a href="/privacy/">Privacy</a></li></ul>
        </div>
      </nav>
    </div>
    <div class="footer-bottom">
      <p class="small">&copy; 2026 {{ site.name }}</p>
      <a class="footer-top" href="#top">Back to top {% icon "up" %}</a>
    </div>
  </div>
</footer>
<a class="to-top" href="#top" aria-label="Back to top" tabindex="-1">{% icon "up" %}</a>
<script src="/assets/js/site.js" defer></script>
{%- if site.cfAnalyticsToken %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>
{%- endif %}
</body>
</html>
